# Copy this file to .env and fill in your values.
# Never commit .env — it is excluded by .gitignore.

# PostgreSQL
POSTGRES_USER=stormcash
POSTGRES_PASSWORD=change_me
POSTGRES_DB=stormcash

# Database connection strings
DATABASE_URL=postgresql://stormcash:change_me@localhost:5433/stormcash
TEST_DATABASE_URL=postgresql://stormcash:change_me@localhost:5433/stormcash_test

# JWT — must be identical across Django and FastAPI services
JWT_SECRET_KEY=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
