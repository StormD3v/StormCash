# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
.next/
out/

# ── Environment variables ─────────────────────────────────────────────────────
# Committed: .env.example (safe placeholder values only)
# Never commit: actual .env files
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv/
.pytest_cache/

# ── Debug and credential artifacts ───────────────────────────────────────────
# These patterns catch debug dumps before they can be committed accidentally
debug_login.txt
check_db.py
create_second_account.py

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
*.log

# ── Cache ─────────────────────────────────────────────────────────────────────
.cache/
.parcel-cache/
.eslintcache
.vite/

# ── Coverage ──────────────────────────────────────────────────────────────────
coverage/
htmlcov/
.coverage

# ── Temporary files ───────────────────────────────────────────────────────────
*.tmp
*.temp
